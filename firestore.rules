rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin identified securely by verified email from runtime
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'Ezrashlomow@gmail.com';
    }

    // 1. Identity Collection: /users/{userId}
    // Admin can see user presence/metadata, but NEVER financial data.
    match /users/{userId} {
      // User can read their own profile, Admin can read list of users
      allow read: if isOwner(userId) || isAdmin();
      
      // User creates own profile upon registration
      allow create: if isOwner(userId);
      
      // User can update their own name/status, Admin can toggle active/deactivated or initiate deletion
      allow update: if isOwner(userId) || isAdmin();
      
      // User or Admin can delete profile document
      allow delete: if isOwner(userId) || isAdmin();

      // 2. Private Financial Data Sub-collections:
      // CRITICAL: Strictly accessible ONLY by the user (request.auth.uid == userId).
      // ADMIN ACCESS IS EXPRESSLY FORBIDDEN (NO isAdmin() condition!).
      match /financial_data/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /investments/{assetId} {
        allow read, write: if isOwner(userId);
      }

      match /commitments/{commitmentId} {
        allow read, write: if isOwner(userId);
      }

      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /rules/{ruleId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
